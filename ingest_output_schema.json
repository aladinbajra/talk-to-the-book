{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Talk to the Book - Ingest Output Schema",
  "description": "Complete schema for the JSON output generated by the master ingest prompt",
  "type": "object",
  "required": [
    "book_id",
    "book_metadata",
    "ingest_summary",
    "book_profile",
    "chunking_plan",
    "retrieval_config",
    "persona_and_voice",
    "qa_datasets",
    "chapter_summaries",
    "canonical_quotes",
    "training_spec",
    "evaluation_spec",
    "runtime_prompts",
    "security_and_ip",
    "dev_checklist",
    "deployment_recommendations",
    "monitoring_and_metrics",
    "deliverables",
    "notes_for_human_review"
  ],
  "properties": {
    "book_id": {
      "type": "string",
      "description": "Unique identifier for the book"
    },
    "book_metadata": {
      "type": "object",
      "required": [
        "title",
        "detected_language",
        "file_format",
        "total_words",
        "copyright_flag"
      ],
      "properties": {
        "title": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "detected_language": { "type": "string" },
        "file_format": { "type": "string" },
        "total_words": { "type": "integer" },
        "total_pages_estimate": { "type": ["integer", "null"] },
        "detected_genres": { "type": "array", "items": { "type": "string" } },
        "detected_publication_clues": { "type": "array", "items": { "type": "string" } },
        "copyright_flag": {
          "type": "string",
          "enum": ["public_domain", "clearly_copyrighted", "unknown"]
        },
        "recommended_user_consent_text": { "type": "string" }
      }
    },
    "ingest_summary": {
      "type": "string",
      "description": "2-6 sentence high-level summary"
    },
    "book_profile": {
      "type": "object",
      "required": [
        "voice_summary",
        "recurring_themes",
        "key_concepts",
        "chapter_index",
        "content_gaps"
      ],
      "properties": {
        "voice_summary": { "type": "string" },
        "recurring_themes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0,
          "maxItems": 8
        },
        "key_concepts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0,
          "maxItems": 20
        },
        "chapter_index": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["chapter_number", "chapter_title", "start_loc", "word_count_est"],
            "properties": {
              "chapter_number": { "type": "integer" },
              "chapter_title": { "type": "string" },
              "start_loc": { "type": "string" },
              "word_count_est": { "type": "integer" }
            }
          }
        },
        "content_gaps": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 8
        }
      }
    },
    "chunking_plan": {
      "type": "object",
      "required": [
        "recommended_chunk_size_words",
        "overlap_percent",
        "chunk_boundary_preference",
        "special_handling_for_quotations",
        "token_estimate_per_chunk",
        "algorithm_description"
      ],
      "properties": {
        "recommended_chunk_size_words": { "type": "integer", "minimum": 400, "maximum": 800 },
        "overlap_percent": { "type": "number", "minimum": 15, "maximum": 30 },
        "chunk_boundary_preference": { "type": "string", "enum": ["YES", "NO"] },
        "special_handling_for_quotations": { "type": "string" },
        "token_estimate_per_chunk": { "type": "integer" },
        "algorithm_description": { "type": "string" }
      }
    },
    "retrieval_config": {
      "type": "object",
      "required": [
        "recommended_embedding_model",
        "embedding_batch_size",
        "vector_index_type",
        "top_k_retrieval_default",
        "similarity_metric",
        "similarity_threshold_default",
        "re_ranking_strategy",
        "caching_policy",
        "cold_start_strategy"
      ],
      "properties": {
        "recommended_embedding_model": { "type": "string" },
        "embedding_batch_size": { "type": "integer" },
        "vector_index_type": { "type": "string" },
        "top_k_retrieval_default": { "type": "integer" },
        "similarity_metric": { "type": "string" },
        "similarity_threshold_default": { "type": "number" },
        "re_ranking_strategy": { "type": "object" },
        "caching_policy": { "type": "string" },
        "cold_start_strategy": { "type": "string" }
      }
    },
    "persona_and_voice": {
      "type": "object",
      "required": [
        "voice_tokens",
        "sentence_length_target",
        "punctuation_profile",
        "formality_level",
        "imperative_tendency",
        "example_transformation_rules",
        "disallowed_phrases"
      ],
      "properties": {
        "voice_tokens": { "type": "array", "items": { "type": "string" } },
        "sentence_length_target": { "type": "number" },
        "punctuation_profile": { "type": "string" },
        "formality_level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "imperative_tendency": { "type": "number", "minimum": 0, "maximum": 1 },
        "example_transformation_rules": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 3,
          "maxItems": 6
        },
        "disallowed_phrases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "qa_datasets": {
      "type": "object",
      "required": ["gold", "synthetic", "interpretive"],
      "properties": {
        "gold": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "chapter", "loc", "question", "answer", "answer_type", "difficulty"],
            "properties": {
              "id": { "type": "string" },
              "chapter": { "type": ["integer", "null"] },
              "loc": { "type": "string" },
              "question": { "type": "string" },
              "answer": { "type": "string" },
              "answer_type": { "type": "string", "enum": ["factual", "interpretive", "summary"] },
              "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] }
            }
          },
          "minItems": 20
        },
        "synthetic": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "question", "answer", "source_chunk_ids", "generation_prompt", "confidence_source_overlap"],
            "properties": {
              "id": { "type": "string" },
              "chapter": { "type": ["integer", "null"] },
              "loc": { "type": ["string", "null"] },
              "question": { "type": "string" },
              "answer": { "type": "string" },
              "answer_type": { "type": "string" },
              "difficulty": { "type": "string" },
              "source_chunk_ids": { "type": "array", "items": { "type": "string" } },
              "generation_prompt": { "type": "string" },
              "confidence_source_overlap": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "minItems": 200
        },
        "interpretive": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "question", "answer", "chunk_ids"],
            "properties": {
              "id": { "type": "string" },
              "question": { "type": "string" },
              "answer": { "type": "string" },
              "chunk_ids": { "type": "array", "items": { "type": "string" } }
            }
          },
          "minItems": 50
        }
      }
    },
    "chapter_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chapter_number",
          "chapter_title",
          "summary",
          "key_sentences",
          "chapter_concepts",
          "relevant_chunk_ids"
        ],
        "properties": {
          "chapter_number": { "type": "integer" },
          "chapter_title": { "type": "string" },
          "summary": { "type": "string" },
          "key_sentences": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 5
          },
          "chapter_concepts": { "type": "array", "items": { "type": "string" } },
          "relevant_chunk_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "canonical_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "quote_text", "page_loc", "paraphrase"],
        "properties": {
          "chunk_id": { "type": "string" },
          "quote_text": { "type": "string" },
          "page_loc": { "type": "string" },
          "paraphrase": { "type": "string" }
        }
      },
      "maxItems": 30
    },
    "training_spec": {
      "type": "object",
      "required": [
        "fine_tune_objective",
        "candidate_model_bases",
        "dataset_prep_instructions",
        "hyperparameter_recs",
        "quantization_and_export",
        "recommended_train_val_split",
        "data_augmentation_strategies",
        "human_in_the_loop_annotation_guidelines"
      ]
    },
    "evaluation_spec": {
      "type": "object",
      "required": [
        "test_set_size",
        "metrics",
        "hallucination_test_suites",
        "multi_turn_evaluations",
        "ab_test_variants"
      ],
      "properties": {
        "hallucination_test_suites": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 10
        },
        "multi_turn_evaluations": {
          "type": "array",
          "items": { "type": "object" },
          "minItems": 10
        }
      }
    },
    "runtime_prompts": {
      "type": "object",
      "required": ["system_prompt", "user_prompt_template", "explainability_prompt"],
      "properties": {
        "system_prompt": { "type": "string" },
        "user_prompt_template": { "type": "string" },
        "explainability_prompt": { "type": "string" }
      }
    },
    "security_and_ip": {
      "type": "object",
      "required": [
        "explicit_user_consent_text",
        "recommended_retention_policy",
        "copyright_risk_flags",
        "pii_handling_rules"
      ]
    },
    "dev_checklist": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 20
    },
    "deployment_recommendations": {
      "type": "object",
      "required": [
        "inference_instance_types",
        "autoscaling_rules",
        "cost_optimization_suggestions"
      ]
    },
    "monitoring_and_metrics": {
      "type": "object",
      "required": [
        "metrics",
        "alert_thresholds",
        "on_call_runbook_steps"
      ]
    },
    "deliverables": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes_for_human_review": {
      "type": "string"
    }
  }
}
