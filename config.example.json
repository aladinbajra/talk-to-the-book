{
  "ingest": {
    "master_prompt_path": "master_ingest_prompt.txt",
    "default_api": "openai",
    "default_model": "gpt-4-turbo-preview",
    "temperature": 0.1,
    "max_tokens": 16000
  },
  "chunking": {
    "default_chunk_size_words": 600,
    "default_overlap_percent": 20,
    "prefer_chapter_boundaries": true
  },
  "embeddings": {
    "default_model": "sentence-transformers/all-mpnet-base-v2",
    "batch_size": 32,
    "normalize": true
  },
  "retrieval": {
    "default_top_k": 6,
    "similarity_threshold": 0.12,
    "index_type": "HNSW",
    "index_parameters": {
      "M": 32,
      "ef_construction": 200,
      "ef_search": 50
    },
    "reranking": {
      "enabled": true,
      "model": "cross-encoder/ms-marco-MiniLM-L-6-v2",
      "rerank_k": 50,
      "final_k": 6
    }
  },
  "runtime": {
    "default_api": "openai",
    "default_model": "gpt-4-turbo-preview",
    "temperature": 0.3,
    "max_conversation_history": 10,
    "enable_explainability": true
  },
  "storage": {
    "ingested_books_dir": "ingested_books",
    "chunks_dir": "chunks",
    "embeddings_dir": "embeddings",
    "datasets_dir": "datasets"
  },
  "security": {
    "retention_days": 180,
    "require_user_consent": true,
    "pii_detection_enabled": true
  },
  "monitoring": {
    "enable_logging": true,
    "log_level": "INFO",
    "metrics_enabled": true,
    "alert_thresholds": {
      "query_latency_p95_ms": 2000,
      "success_rate_min": 0.95,
      "unknown_rate_max": 0.30
    }
  }
}
